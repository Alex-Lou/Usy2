# Réglages du serveur MemoCat. Copie ce fichier en deploy/.env puis remplis-le :
#   cp deploy/.env.example deploy/.env && nano deploy/.env
# deploy/.env n'est jamais versionné (il contient les secrets).

# Ton nom de domaine, sans https:// (ex. memocat.fr). Il doit déjà pointer vers l'IP du serveur.
DOMAIN=

# Deux secrets longs et aléatoires. Pour en générer un : openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
POSTGRES_PASSWORD=
MEMOCAT_JWT_SECRET=

# Les deux comptes : À LAISSER VIDES si tu migres tes données (les comptes existent déjà,
# avec vos mots de passe actuels). À remplir seulement pour une installation toute neuve.
MEMOCAT_USER1_USERNAME=
MEMOCAT_USER1_PASSWORD=
MEMOCAT_USER1_DISPLAY_NAME=
MEMOCAT_USER2_USERNAME=
MEMOCAT_USER2_PASSWORD=
MEMOCAT_USER2_DISPLAY_NAME=

# Place maximale des photos et fichiers, en Mo (10000 = 10 Go). Garde de la marge pour les
# sauvegardes sur le disque du serveur.
MEMOCAT_STORAGE_QUOTA_MB=10000

# Votre fuseau horaire (« aujourd'hui » pour les souvenirs et la grille du jour).
MEMOCAT_TIMEZONE=Atlantic/Canary

# Sauvegardes : chaque nuit à cette heure (UTC), gardées N jours, plus celle du 1er de chaque
# mois pendant N mois.
BACKUP_HOUR_UTC=2
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_MONTHS=6

# Version de PostgreSQL. Ne la change qu'avant le premier démarrage : elle doit être égale ou
# supérieure à celle de ta base actuelle (le script de migration le vérifie et te le dira).
POSTGRES_VERSION=17
